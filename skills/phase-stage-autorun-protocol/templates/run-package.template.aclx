kind=phase_stage_autorun_run
protocolVersion=phase-stage-autorun/codex-v1
runtimeTier=t3
runId={{run_id}}
title={{run_title}}
createdAt={{created_at}}

artifacts.goal={{goal_path}}
artifacts.queue={{queue_path}}
artifacts.status={{status_path}}
artifacts.controllingProtocol={{controlling_protocol_path}}
artifacts.checkpoints={{checkpoints_dir}}
artifacts.snapshots={{snapshots_dir}}

queue.items={{queue_items_json}}
queue.cursor={{queue_cursor}}
stage.current={{current_stage_id}}
stage.state={{stage_state}}
stage.next={{next_action}}
stage.blocker={{blocker}}

audit.passStreak={{audit_pass_streak}}
audit.failStreak={{audit_fail_streak}}

verify.latest={{latest_verification}}
resume.point={{resume_point}}

inv.queueOrder=immutable
inv.advanceOnlyFromDone=true
inv.noStageSkip=true
inv.userInterruptRequiresBlocker=true
